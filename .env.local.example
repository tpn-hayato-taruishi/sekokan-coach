# AWS 認証情報は「書きません」。
# SDK の標準クレデンシャルチェーンに任せます:
#   - ローカル開発: ~/.aws/credentials のプロファイル (AWS_PROFILE=xxx npm run dev)
#   - App Runner  : IAM インスタンスロール
# アクセスキーを env に書く運用は廃止しました (AWS 指摘事項: 長期キーを使わない)。
AWS_REGION=ap-northeast-1

# Bedrock モデル ID (オプション — 未設定なら Claude 3 Haiku / ap-northeast-1)
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# プロキシ (社内NWで Bedrock 直接アクセス不可の場合)
# HTTPS_PROXY=http://proxy.toppan.co.jp:8088
# HTTP_PROXY=http://proxy.toppan.co.jp:8088

# 月次予算上限 (円). 超えるとAPI呼び出しブロック
BEDROCK_MONTHLY_LIMIT_YEN=5000
